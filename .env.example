# Path to Faction JSON config (optional — demos use embedded defaults when unset)
FACTIONER_CONFIG=./factioner.config.example.json

# Gateway overlays
# FACTIONER_GATEWAY_API_KEY=replace-me
# FACTIONER_GATEWAY_HOST=127.0.0.1
# FACTIONER_GATEWAY_PORT=8080
# FACTIONER_GATEWAY_MAX_BODY_BYTES=10485760

# Per-endpoint budget / secret overlays (ID chars uppercased; non-alnum → _)
# FACTIONER_ENDPOINT_AZURE_OPENAI_EASTUS_TPM=30000
# FACTIONER_ENDPOINT_AZURE_OPENAI_EASTUS_RPM=600
# FACTIONER_ENDPOINT_AZURE_OPENAI_EASTUS_MAX_CONCURRENCY=4
# FACTIONER_ENDPOINT_AZURE_OPENAI_EASTUS_API_KEY=sk-...
# FACTIONER_ENDPOINT_OPENAI_DIRECT_PRIMARY_API_KEY=sk-...

# Legacy aliases still accepted: FACTION_CONFIG, FACTION_ENDPOINT_*
